# Copy to .env and fill in your own Invisalign VIP credentials.
# Never commit .env.
VIP_USERNAME=your-vip-login@example.com
VIP_PASSWORD=your-vip-password

# Optional portal defaults. Usually you do not need to change these.
VIP_LOGIN_URL=https://vip.invisalign.com/v3/auth/patients.action
VIP_PATIENT_LIST_URL=https://vip.invisalign.com/v3/auth/patient/patientList.action

# Runtime options.
HEADLESS=true
SLOW_MO_MS=0
STATE_DIR=./state
TIMEZONE=Asia/Seoul

# Action-required monitor.
# The monitor prints nothing when there is no change by default, making it cron-friendly.
ACTION_REQUIRED_NOTIFY_EMPTY=false
ACTION_REQUIRED_REDACT_PATIENTS=false
ACTION_REQUIRED_CRON=*/30 * * * *

# Additional Aligners start workflow safety.
# aa:start requires explicit patient search args and defaults to dry-run unless --confirm is passed.
AA_DEFAULT_DRY_RUN=true
